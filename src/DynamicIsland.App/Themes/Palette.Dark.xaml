    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ShortcutCardBackgroundBrush" Color="#FF10141C" />
    <SolidColorBrush x:Key="ShortcutCardBorderBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ShortcutEmptyBackgroundBrush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="ShortcutEmptyBorderBrush" Color="#28FFFFFF" />
