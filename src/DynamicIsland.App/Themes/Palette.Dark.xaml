<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette -->
    <Color x:Key="AccentColor">#74D6FF</Color>
    <Color x:Key="PulseColor">#35E985</Color>
    <Color x:Key="AccentBlueColor">#B69CFF</Color>
    <Color x:Key="TextPrimaryColor">#F8F6F0</Color>
    <Color x:Key="TextSecondaryColor">#B9B5AC</Color>
    <Color x:Key="TextMutedColor">#85827B</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF2F2F37" />
    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A8C" />
    <SolidColorBrush x:Key="WindowShadowBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="CompactDotBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="CompactSeparatorBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CompactRingTrackBrush" Color="#2BFFFFFF" />
