<Window x:Class="DynamicIsland.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛"
        Width="276"
        Height="74"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Grid x:Name="Root" Margin="14">
        <!-- Shadow is a separate layer so text is not rasterized by the effect. -->
        <Border CornerRadius="23" Background="#FF000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Color="#FF000000"
                                  Opacity="0.58" />
            </Border.Effect>
        </Border>

        <Border x:Name="Shell"
                CornerRadius="23"
                Background="{StaticResource IslandSurfaceBrush}"
                BorderBrush="{StaticResource IslandEdgeBrush}"
                BorderThickness="1"
                Cursor="Hand"
                AllowDrop="True"
                MouseEnter="Window_MouseEnter"
                MouseLeave="Window_MouseLeave"
                MouseLeftButtonUp="Shell_MouseLeftButtonUp"
                DragEnter="Shell_DragEnter"
                DragOver="Shell_DragOver"
                DragLeave="Shell_DragLeave"
                Drop="Shell_Drop">
            <Border.ContextMenu>
                <ContextMenu Opened="IslandMenu_Opened" Closed="IslandMenu_Closed">
                    <MenuItem Header="打开设置…" Click="Settings_Click" />
                    <MenuItem Header="播放演示通知" Click="DemoNotification_Click" />
                    <MenuItem Header="隐藏到托盘" Click="Hide_Click" />
                    <Separator />
                    <MenuItem Header="退出灵动岛" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Compact -->
                <Grid x:Name="CompactView"
                      Margin="18,0"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="CompactTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Ellipse Width="16" Height="16" Fill="#16FFFFFF" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGradientBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Color="#FF6FE7C8"
                                                  Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="9,0,0,0">
                        <TextBlock Text="{Binding UserName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxWidth="64"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UserName}" />
                        <Border Width="1" Height="10" Background="#1FFFFFFF" Margin="9,0" />
                        <TextBlock Text="{Binding Greeting}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding SecondsDisplay}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="1,2,0,0"
                                   Typography.NumeralAlignment="Tabular"
                                   Visibility="{Binding ShowSeconds, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Ellipse Grid.Column="3"
                             Width="5"
                             Height="5"
                             Margin="10,0,0,0"
                             Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <!-- Expanded -->
                <Grid x:Name="ExpandedView"
                      Margin="22,14,22,12"
                      Opacity="0"
                      Visibility="Collapsed"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="ExpandedTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="34"
                                       FontWeight="SemiBold"
                                       LineHeight="38"
                                       Typography.NumeralAlignment="Tabular"><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="{Binding ExpandedSeconds, Mode=OneWay}"
                                                                                                                                                    FontSize="12"
                                                                                                                                                    Foreground="{StaticResource TextSecondaryBrush}" /></TextBlock>
                            <TextBlock Text="{Binding DateText}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="1,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BatteryText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <Grid Width="34" Height="16" VerticalAlignment="Center">
                                    <Border Width="30"
                                            Height="14"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            BorderBrush="#55FFFFFF"
                                            BorderThickness="1"
                                            Padding="2">
                                        <Border Height="8"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                Width="{Binding BatteryFillWidth}">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Border>
                                    <Border Width="2"
                                            Height="6"
                                            HorizontalAlignment="Right"
                                            CornerRadius="0,1,1,0"
                                            Background="#55FFFFFF" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding PowerLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="0,10,0,10" />

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3"
                                        Height="10"
                                        CornerRadius="1.5"
                                        Background="{StaticResource AccentBrush}"
                                        Margin="0,0,7,0" />
                                <TextBlock Text="功能区"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text=" / "
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ActiveFunctionTitle}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFileShelfActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ShelfCountText}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Content="清空"
                                        Click="ClearShelf_Click"
                                        ToolTip="清空暂存区">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Height" Value="20" />
                                            <Setter Property="Padding" Value="8,2" />
                                            <Setter Property="FontSize" Value="9" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStagedFiles}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCalendarActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding CalendarStatusText}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Content="刷新"
                                        Click="RefreshCalendar_Click"
                                        ToolTip="刷新 Outlook 日历">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Height" Value="20" />
                                            <Setter Property="Padding" Value="8,2" />
                                            <Setter Property="FontSize" Value="9" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ShelfDropZone"
                                Grid.Row="1"
                                Height="108"
                                Margin="0,6,0,0"
                                Background="#08FFFFFF"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6"
                                AllowDrop="True">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileShelfActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStagedFiles}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Rectangle Stroke="#24FFFFFF"
                                               StrokeThickness="1"
                                               StrokeDashArray="3 3"
                                               RadiusX="9"
                                               RadiusY="9"
                                               Fill="Transparent"
                                               IsHitTestVisible="False" />
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                            <Path Data="M3,6 C3,4.9 3.9,4 5,4 L9.2,4 L11.2,6 L19,6 C20.1,6 21,6.9 21,8 L21,17 C21,18.1 20.1,19 19,19 L5,19 C3.9,19 3,18.1 3,17 Z"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent" />
                                        </Viewbox>
                                        <TextBlock Text="把文件拖到这里暂存"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="支持文件和文件夹 · 拖出时复制"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStagedFiles}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding StagedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0BFFFFFF"
                                                            BorderBrush="#12FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="7,4"
                                                            Margin="0,0,0,4"
                                                            Cursor="Hand"
                                                            AllowDrop="True"
                                                            ToolTip="按住拖出到资源管理器或其他应用（复制）"
                                                            PreviewMouseLeftButtonDown="StagedFile_MouseLeftButtonDown"
                                                            MouseLeftButtonUp="StagedFile_MouseLeftButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Width="28"
                                                                    Height="18"
                                                                    CornerRadius="4"
                                                                    Background="#14FFFFFF"
                                                                    Margin="0,0,7,0">
                                                                <TextBlock Text="{Binding KindLabel}"
                                                                           FontSize="8"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SizeText}"
                                                                       FontSize="9"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       MinWidth="44"
                                                                       TextAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,2,0" />

                                                            <Button Grid.Column="3"
                                                                    Content="×"
                                                                    Width="20"
                                                                    Height="20"
                                                                    FontSize="11"
                                                                    Padding="0"
                                                                    Style="{StaticResource IconButton}"
                                                                    ToolTip="移出暂存"
                                                                    Click="RemoveStagedFile_Click" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <Border x:Name="ShelfHighlight"
                                        Background="#1F6FE7C8"
                                        BorderBrush="#666FE7C8"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Height="108"
                                Margin="0,6,0,0"
                                Background="#08FFFFFF"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalendarActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="正在读取 Outlook 日历…"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="首次连接可能需要几秒"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCalendarError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                        <TextBlock Text="{Binding CalendarErrorTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CalendarErrorMessage}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxHeight="34"
                                                   Margin="0,3,0,4" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="重试"
                                                    Click="RefreshCalendar_Click"
                                                    Margin="0,0,6,0">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Height" Value="20" />
                                                        <Setter Property="Padding" Value="9,2" />
                                                        <Setter Property="FontSize" Value="9" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="设置"
                                                    Click="OpenSettingsFromCalendar_Click">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Height" Value="20" />
                                                        <Setter Property="Padding" Value="9,2" />
                                                        <Setter Property="FontSize" Value="9" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                            <Path Data="M4,6 C4,4.9 4.9,4 6,4 L18,4 C19.1,4 20,4.9 20,6 L20,18 C20,19.1 19.1,20 18,20 L6,20 C4.9,20 4,19.1 4,18 Z M4,9 L20,9 M8,2 L8,6 M16,2 L16,6"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent" />
                                        </Viewbox>
                                        <TextBlock Text="今天没有日程"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="Outlook 日历已连接"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCalendarEvents}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding CalendarEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0BFFFFFF"
                                                            BorderBrush="#12FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="7,4"
                                                            Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       FontSize="8.8"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Subject}"
                                                                           FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding LocationText}"
                                                                           FontSize="8.5"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,1,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasLocation}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Click="FileTab_Click"
                                Tag="{Binding IsFileShelfActive}"
                                ToolTip="文件暂存"
                                AutomationProperties.Name="文件暂存">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DotTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileShelfActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="CalendarTab_Click"
                                Tag="{Binding IsCalendarActive}"
                                ToolTip="Outlook 日历"
                                AutomationProperties.Name="Outlook 日历">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DotTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalendarActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <TextBlock Text="{Binding FooterHint}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PinHint}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Notification -->
                <Grid x:Name="NotificationView"
                      Margin="20,18"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NotificationScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="NotificationTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="44" Height="44" VerticalAlignment="Top">
                        <Ellipse Fill="#176FE7C8" />
                        <Ellipse Width="36" Height="36" Fill="#0DFFFFFF" />
                        <Viewbox Width="21" Height="21">
                            <Path Data="M12,2 C8.686,2 6,4.686 6,8 L6,12.2 L4.4,15.4 C4.1,16 4.55,16.7 5.22,16.7 L18.78,16.7 C19.45,16.7 19.9,16 19.6,15.4 L18,12.2 L18,8 C18,4.686 15.314,2 12,2 Z M9.5,19 C9.85,20.16 10.85,21 12,21 C13.15,21 14.15,20.16 14.5,19 Z"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                    </Grid>

                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding NotificationTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NotificationMessage}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2"
                                   Text="点击关闭"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
