    <SolidColorBrush x:Key="AgentUserBubbleBorderBrush" Color="#4A6FE7C8" />
    <SolidColorBrush x:Key="AgentAssistantBubbleBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="AgentAssistantBubbleBorderBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#F513151D" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TooltipSurfaceBrush" Color="#F0141720" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#50FFFFFF" />
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#FF2A2F3A" />
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFB8BDC9" />
    <SolidColorBrush x:Key="SwitchKnobCheckedBrush" Color="#FF09130F" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbHaloBrush" Color="#8A8A93" />
    <SolidColorBrush x:Key="TodoCheckRingBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="TodoCheckMarkBrush" Color="#FF081018" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#FF8FF2D9" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#FF58C9AD" />
    <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="#FF07120E" />
    <SolidColorBrush x:Key="GhostButtonBackgroundBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonPressedBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TabDotBrush" Color="#8A8A93" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#5574D6FF" />
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#1AFF7A8C" />

    <LinearGradientBrush x:Key="IslandSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF3B3B44" />
        <GradientStop Offset="0.52" Color="#FF2F2F37" />
        <GradientStop Offset="1" Color="#FF27272E" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="IslandEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#38FFFFFF" />
        <GradientStop Offset="0.45" Color="#12FFFFFF" />
        <GradientStop Offset="1" Color="#08FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#74D6FF" />
        <GradientStop Offset="1" Color="#B69CFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SettingsBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0E1118" />
        <GradientStop Offset="1" Color="#FF080A0F" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PulseBrush" Color="#35E985" />
    <SolidColorBrush x:Key="IslandAccentLineBrush" Color="#3A74D6FF" />

    <DrawingBrush x:Key="IslandGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,100,42"
                  ViewportUnits="Absolute"
                  Stretch="None"
                  Opacity="0.65">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#0DFFFFFF" Thickness="1" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <LineGeometry StartPoint="0,41.5" EndPoint="100,41.5" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
