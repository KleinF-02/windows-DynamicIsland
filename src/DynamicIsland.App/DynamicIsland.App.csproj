<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>灵动岛</Product>
    <AssemblyTitle>灵动岛 for Windows 11</AssemblyTitle>
    <Description>A lightweight Dynamic Island for Windows 11.</Description>
    <Company>DynamicIsland</Company>
    <!-- Version is centralized in Directory.Build.props and the root VERSION file. -->
    <!-- The manifest is the authoritative DPI declaration for this WPF app. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.Core\DynamicIsland.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="4.3.1" />
  </ItemGroup>

</Project>
