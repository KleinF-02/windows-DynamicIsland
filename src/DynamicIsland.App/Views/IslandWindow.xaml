<Window x:Class="DynamicIsland.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛"
        Width="276"
        Height="74"
        WindowStyle="None"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Deactivated="Window_Deactivated"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Grid x:Name="Root" Margin="14">
        <!-- Shadow is a separate layer so text is not rasterized by the effect. -->
        <Border CornerRadius="23" Background="#FF000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="5"
                                  Direction="270"
                                  Color="#FF000000"
                                  Opacity="0.58" />
            </Border.Effect>
        </Border>

        <Border x:Name="Shell"
                CornerRadius="23"
                Background="{StaticResource IslandSurfaceBrush}"
                BorderBrush="{StaticResource IslandEdgeBrush}"
                BorderThickness="1"
                Cursor="Hand"
                AllowDrop="True"
                MouseEnter="Window_MouseEnter"
                MouseLeave="Window_MouseLeave"
                MouseLeftButtonUp="Shell_MouseLeftButtonUp"
                DragEnter="Shell_DragEnter"
                DragOver="Shell_DragOver"
                DragLeave="Shell_DragLeave"
                Drop="Shell_Drop">
            <Border.ContextMenu>
                <ContextMenu Opened="IslandMenu_Opened" Closed="IslandMenu_Closed">
                    <MenuItem Header="打开设置…" Click="Settings_Click" />
                    <MenuItem Header="播放演示通知" Click="DemoNotification_Click" />
                    <MenuItem Header="隐藏到托盘" Click="Hide_Click" />
                    <Separator />
                    <MenuItem Header="退出灵动岛" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Compact -->
                <Grid x:Name="CompactView"
                      Margin="18,0"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="CompactTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeetingCountdownActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Width="16" Height="16" Fill="#16FFFFFF" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGradientBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="0"
                                                  Color="#FF6FE7C8"
                                                  Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="9,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeetingCountdownActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding UserName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxWidth="64"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UserName}" />
                        <Border Width="1" Height="10" Background="#1FFFFFFF" Margin="9,0" />
                        <TextBlock Text="{Binding Greeting}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeetingCountdownActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding SecondsDisplay}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="1,2,0,0"
                                   Typography.NumeralAlignment="Tabular"
                                   Visibility="{Binding ShowSeconds, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Grid Grid.Column="0"
                          Grid.ColumnSpan="3"
                          VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMeetingCountdownActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="21" Height="21" VerticalAlignment="Center">
                            <Grid Width="90" Height="90">
                                <Ellipse Width="80"
                                         Height="80"
                                         Stroke="#2BFFFFFF"
                                         StrokeThickness="6" />
                                <Path Data="{Binding CountdownRingGeometry}"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent" />
                            </Grid>
                        </Viewbox>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountdownSubject}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="8,0,8,0"
                                   ToolTip="{Binding CountdownSubject}" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding CountdownText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <Ellipse Grid.Column="3"
                             Width="5"
                             Height="5"
                             Margin="10,0,0,0"
                             Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <!-- Expanded -->
                <Grid x:Name="ExpandedView"
                      Margin="22,14,22,12"
                      Opacity="0"
                      Visibility="Collapsed"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="ExpandedTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="34"
                                       FontWeight="SemiBold"
                                       LineHeight="38"
                                       Typography.NumeralAlignment="Tabular"><Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="{Binding ExpandedSeconds, Mode=OneWay}"
                                                                                                                                                    FontSize="12"
                                                                                                                                                    Foreground="{StaticResource TextSecondaryBrush}" /></TextBlock>
                            <TextBlock Text="{Binding DateText}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="1,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding BatteryText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <Grid Width="34" Height="16" VerticalAlignment="Center">
                                    <Border Width="30"
                                            Height="14"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            BorderBrush="#55FFFFFF"
                                            BorderThickness="1"
                                            Padding="2">
                                        <Border Height="8"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                Width="{Binding BatteryFillWidth}">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Border>
                                    <Border Width="2"
                                            Height="6"
                                            HorizontalAlignment="Right"
                                            CornerRadius="0,1,1,0"
                                            Background="#55FFFFFF" />
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding PowerLabel}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="0,10,0,10" />

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3"
                                        Height="10"
                                        CornerRadius="1.5"
                                        Background="{StaticResource AccentBrush}"
                                        Margin="0,0,7,0" />
                                <TextBlock Text="{Binding ActiveFunctionTitle}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShortcutsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ShortcutCountText}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCalendarActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding CalendarStatusText}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           ToolTip="若显示“主题未公开”，请在 Outlook 网页版重新发布日历，并将权限设为“可查看所有详细信息”。" />
                                <Button Content="刷新"
                                        Click="RefreshCalendar_Click"
                                        ToolTip="刷新 Calendar">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Height" Value="20" />
                                            <Setter Property="Padding" Value="8,2" />
                                            <Setter Property="FontSize" Value="9" />
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTodoActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding TodoCountText}"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Height="108"
                                Margin="0,6,0,0"
                                Background="#08FFFFFF"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShortcutsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <ItemsControl ItemsSource="{Binding ShortcutSlots}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="94"
                                              Margin="1,0"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              MouseEnter="ShortcutTile_MouseEnter"
                                              MouseLeave="ShortcutTile_MouseLeave"
                                              MouseLeftButtonUp="ShortcutTile_MouseLeftButtonUp"
                                              DragOver="ShortcutTile_DragOver"
                                              DragLeave="ShortcutTile_DragLeave"
                                              Drop="ShortcutTile_Drop"
                                              RenderTransformOrigin="0.5,0.85">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Grid.RenderTransform>
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="打开"
                                                              Click="OpenShortcutMenu_Click"
                                                              IsEnabled="{Binding HasShortcut}" />
                                                    <MenuItem Header="移除此快捷方式"
                                                              Click="RemoveShortcutMenu_Click"
                                                              IsEnabled="{Binding HasShortcut}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Button x:Name="ShortcutRemove"
                                                    Content="×"
                                                    Width="14"
                                                    Height="14"
                                                    FontSize="10"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,3,0"
                                                    Panel.ZIndex="30"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="移除快捷方式"
                                                    Click="RemoveShortcutButton_Click" />

                                            <Grid x:Name="ShortcutFilled">
                                                <Grid.Style>
                                                    <Style TargetType="{x:Type Grid}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShortcut}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Border x:Name="ShortcutCard"
                                                        Width="48"
                                                        Height="48"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Margin="0,4,0,0"
                                                        Background="#10141C"
                                                        BorderBrush="#20FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="11">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding Icon}"
                                                               Width="28"
                                                               Height="28"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           Margin="0,0,0,2"
                                                           MaxWidth="58"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <StackPanel x:Name="ShortcutEmpty"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ToolTip="点击从开始菜单选择，或直接拖入快捷方式">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShortcut}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="48"
                                                        Height="48"
                                                        Background="#06FFFFFF"
                                                        BorderBrush="#28FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="11">
                                                    <TextBlock Text="+"
                                                               FontSize="20"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="拖入 / 选择"
                                                           FontSize="8"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border Grid.Row="1"
                                Height="108"
                                Margin="0,6,0,0"
                                Background="#08FFFFFF"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalendarActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="正在读取 Calendar…"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="首次连接可能需要几秒"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCalendarError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                                        <TextBlock Text="{Binding CalendarErrorTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CalendarErrorMessage}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxHeight="34"
                                                   Margin="0,3,0,4" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="重试"
                                                    Click="RefreshCalendar_Click"
                                                    Margin="0,0,6,0">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Height" Value="20" />
                                                        <Setter Property="Padding" Value="9,2" />
                                                        <Setter Property="FontSize" Value="9" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="设置"
                                                    Click="OpenSettingsFromCalendar_Click">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                                        <Setter Property="Height" Value="20" />
                                                        <Setter Property="Padding" Value="9,2" />
                                                        <Setter Property="FontSize" Value="9" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
                                            <Path Data="M4,6 C4,4.9 4.9,4 6,4 L18,4 C19.1,4 20,4.9 20,6 L20,18 C20,19.1 19.1,20 18,20 L6,20 C4.9,20 4,19.1 4,18 Z M4,9 L20,9 M8,2 L8,6 M16,2 L16,6"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent" />
                                        </Viewbox>
                                        <TextBlock Text="今天没有日程"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="Calendar 已连接"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCalendarEvents}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding CalendarEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0BFFFFFF"
                                                            BorderBrush="#12FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="7,4"
                                                            Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       FontSize="8.8"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Subject}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Subject}" />
                                                                <TextBlock Text="{Binding LocationText}"
                                                                           FontSize="8.5"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,1,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="{x:Type TextBlock}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasLocation}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <Grid Panel.ZIndex="20">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMeetingCountdownActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Border Background="#FF0B0E14"
                                            BorderBrush="#2E6FE7C8"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="86" Height="86">
                                                <Ellipse Width="80"
                                                         Height="80"
                                                         Stroke="#1AFFFFFF"
                                                         StrokeThickness="4" />
                                                <Path Data="{Binding CountdownRingGeometry}"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Fill="Transparent" />
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountdownText}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock Text="剩余"
                                                               FontSize="8"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,-2,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="下一场会议"
                                                           FontSize="8.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding CountdownSubject}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding CountdownStartText}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="TodoPanel"
                                Grid.Row="1"
                                Height="108"
                                Margin="0,6,0,0"
                                Background="#08FFFFFF"
                                BorderBrush="#16FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodoActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#0BFFFFFF"
                                            BorderBrush="#18FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="8,0">
                                        <Grid>
                                            <TextBox x:Name="TodoInput"
                                                     Style="{StaticResource SettingsTextBox}"
                                                     Height="26"
                                                     MaxLength="120"
                                                     Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="TodoInput_KeyDown"
                                                     GotFocus="TodoText_GotFocus"
                                                     AutomationProperties.Name="添加待办" />
                                            <TextBlock Text="添加待办，回车保存"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="1,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsTodoInputEmpty}" Value="True" />
                                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TodoInput}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="26"
                                            Height="26"
                                            FontSize="16"
                                            Padding="0"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource IconButton}"
                                            Foreground="{StaticResource AccentBrush}"
                                            ToolTip="添加待办"
                                            AutomationProperties.Name="添加待办按钮"
                                            Click="AddTodo_Click" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ScrollViewer.Style>
                                            <Style TargetType="{x:Type ScrollViewer}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTodos}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <ItemsControl ItemsSource="{Binding Todos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Tag="TodoRow"
                                                            Background="#0BFFFFFF"
                                                            BorderBrush="#12FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="6,3"
                                                            Margin="0,0,0,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{StaticResource TodoCheckBox}"
                                                                      IsChecked="{Binding IsCompleting, Mode=TwoWay}"
                                                                      Checked="TodoCheck_Checked"
                                                                      AutomationProperties.Name="完成待办"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,7,0" />
                                                            <TextBox Grid.Column="1"
                                                                     Style="{StaticResource SettingsTextBox}"
                                                                     Height="22"
                                                                     MaxLength="120"
                                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                     LostFocus="TodoText_LostFocus"
                                                                     PreviewKeyDown="TodoText_KeyDown"
                                                                     GotFocus="TodoText_GotFocus"
                                                                     VerticalContentAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTodoEmpty}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="还没有待办"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="输入后回车或点 + 添加"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Canvas x:Name="TodoParticleCanvas"
                                            Panel.ZIndex="10"
                                            IsHitTestVisible="False"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Click="ShortcutsTab_Click"
                                Tag="{Binding IsShortcutsActive}"
                                ToolTip="常用软件"
                                AutomationProperties.Name="常用软件">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DotTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShortcutsActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="CalendarTab_Click"
                                Tag="{Binding IsCalendarActive}"
                                ToolTip="Calendar"
                                AutomationProperties.Name="Calendar">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DotTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalendarActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="TodoTab_Click"
                                Tag="{Binding IsTodoActive}"
                                ToolTip="待办事项"
                                AutomationProperties.Name="待办事项">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DotTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTodoActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <TextBlock Text="{Binding FooterHint}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" />
                        <Button x:Name="PinButton"
                                Click="PinButton_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Height="22"
                                MinWidth="70"
                                Padding="8,2"
                                ToolTip="{Binding PinButtonText}"
                                AutomationProperties.Name="{Binding PinButtonText}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="FontSize" Value="9" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding PinButtonText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Notification -->
                <Grid x:Name="NotificationView"
                      Margin="20,18"
                      Opacity="0"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NotificationScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="NotificationTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="44" Height="44" VerticalAlignment="Top">
                        <Ellipse Fill="#176FE7C8" />
                        <Ellipse Width="36" Height="36" Fill="#0DFFFFFF" />
                        <Viewbox Width="21" Height="21">
                            <Path Data="M12,2 C8.686,2 6,4.686 6,8 L6,12.2 L4.4,15.4 C4.1,16 4.55,16.7 5.22,16.7 L18.78,16.7 C19.45,16.7 19.9,16 19.6,15.4 L18,12.2 L18,8 C18,4.686 15.314,2 12,2 Z M9.5,19 C9.85,20.16 10.85,21 12,21 C13.15,21 14.15,20.16 14.5,19 Z"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                    </Grid>

                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding NotificationTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NotificationMessage}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2"
                                   Text="点击关闭"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
