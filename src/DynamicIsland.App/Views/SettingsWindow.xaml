<Window x:Class="DynamicIsland.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="灵动岛设置"
        Width="480"
        Height="690"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="28" Height="28" Margin="26,0,10,0" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource AccentGradientBrush}" />
                <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentButtonForegroundBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="灵动岛" FontSize="13.5" FontWeight="SemiBold" />
                <TextBlock Text="Dynamic Island for Windows 11"
                           FontSize="9.5"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="✕"
                    Style="{StaticResource IconButton}"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    ToolTip="关闭"
                    Click="Close_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,0">
            <StackPanel Margin="26,4,26,20">
                <TextBlock Text="让桌面边缘" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="多一点呼吸感。" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="把时间、电量与通知收进一颗胶囊。悬停展开，点击固定。"
                           Style="{StaticResource CaptionText}"
                           Margin="0,9,0,16" />

                <TextBlock Text="行为" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,1,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="始终置顶" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="保持在其他窗口之上" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                      AutomationProperties.Name="始终置顶"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Hairline}" />

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="过渡动画" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="展开与收起使用弹性缓动" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="过渡动画"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Hairline}" />

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="显示秒数" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="在时钟右侧显示实时秒数" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding ShowSeconds, Mode=TwoWay}"
                                      AutomationProperties.Name="显示秒数"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Hairline}" />

                        <Grid Margin="0,10,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开机自动启动" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="登录 Windows 后在后台静默启动"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      AutomationProperties.Name="开机自动启动"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="日历" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Outlook 网页日历" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="适用于 Microsoft 365 网页版。在 Outlook 网页版依次打开：设置 → 日历 → 共享日历 → 发布日历，复制生成的 ICS 链接。"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" />
                        <Border Background="{DynamicResource SettingsFieldBackgroundBrush}"
                                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                Padding="10,0"
                                Margin="0,10,0,0">
                            <TextBox Text="{Binding WebCalendarUrl, Mode=TwoWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="Outlook 网页日历 ICS 链接" />
                        </Border>
                        <TextBlock Text="留空则尝试桌面版 Outlook。链接包含访问令牌，仅保存在本机设置中。"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="翻译" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="本地大模型翻译" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="支持 Ollama（默认 11434）以及 LM Studio / llama.cpp 等 OpenAI 兼容服务。翻译请求只发送到本机地址。"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" />

                        <TextBlock Text="服务地址"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,10,0,4" />
                        <Border Background="{DynamicResource SettingsFieldBackgroundBrush}"
                                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                Padding="10,0">
                            <TextBox Text="{Binding LocalLlmEndpoint, Mode=TwoWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="本地大模型服务地址" />
                        </Border>

                        <TextBlock Text="模型名（留空自动选择）"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,8,0,4" />
                        <Border Background="{DynamicResource SettingsFieldBackgroundBrush}"
                                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                Padding="10,0">
                            <TextBox Text="{Binding LocalLlmModel, Mode=TwoWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="本地大模型名称" />
                        </Border>

                        <TextBlock Text="Ollama 示例：http://127.0.0.1:11434；LM Studio 示例：http://127.0.0.1:1234"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="AI Agent API（可选）" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="独立 API 配置" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="留空沿用上方本地模型；填写后 AI Agent 单独使用这里的 endpoint / model / API Key。支持 OpenAI 兼容 API 或带鉴权的 Ollama。"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" />

                        <TextBlock Text="供应商"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,10,0,4" />
                        <WrapPanel>
                            <Button Content="本地模型"
                                    Tag="local"
                                    Style="{StaticResource GhostButton}"
                                    Height="26"
                                    Padding="8,2"
                                    Margin="0,0,5,4"
                                    FontSize="10"
                                    Click="AgentProvider_Click" />
                            <Button Content="自定义"
                                    Tag="custom"
                                    Style="{StaticResource GhostButton}"
                                    Height="26"
                                    Padding="8,2"
                                    Margin="0,0,5,4"
                                    FontSize="10"
                                    Click="AgentProvider_Click" />
                            <Button Content="DeepSeek"
                                    Tag="deepseek"
                                    Style="{StaticResource GhostButton}"
                                    Height="26"
                                    Padding="8,2"
                                    Margin="0,0,5,4"
                                    FontSize="10"
                                    Click="AgentProvider_Click" />
                            <Button Content="Kimi"
                                    Tag="kimi"
                                    Style="{StaticResource GhostButton}"
                                    Height="26"
                                    Padding="8,2"
                                    Margin="0,0,5,4"
                                    FontSize="10"
                                    Click="AgentProvider_Click" />
                            <Button Content="GLM"
                                    Tag="glm"
                                    Style="{StaticResource GhostButton}"
                                    Height="26"
                                    Padding="8,2"
                                    Margin="0,0,5,4"
                                    FontSize="10"
                                    Click="AgentProvider_Click" />
                            <TextBlock Text="{Binding AgentProviderLabel}"
                                       FontSize="9"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,4" />
                        </WrapPanel>

                        <TextBlock Text="API 地址"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,10,0,4" />
                        <Border Background="{DynamicResource SettingsFieldBackgroundBrush}"
                                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                Padding="10,0">
                            <TextBox Text="{Binding AgentApiEndpoint, Mode=TwoWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="AI Agent API 地址" />
                        </Border>

                        <TextBlock Text="模型名"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,8,0,4" />
                        <Border Background="{DynamicResource SettingsFieldBackgroundBrush}"
                                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                Padding="10,0">
                            <TextBox Text="{Binding AgentApiModel, Mode=TwoWay}"
                                     Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="AI Agent API 模型名" />
                        </Border>

                        <TextBlock Text="API Key（Bearer Token，可留空）"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,8,0,4" />
                        <Border Background="{DynamicResource SettingsFieldBackgroundBrush}"
                                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="32"
                                Padding="10,0">
                            <PasswordBox x:Name="AgentApiKeyBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="AgentApiKeyBox_PasswordChanged"
                                         AutomationProperties.Name="AI Agent API Key" />
                        </Border>
                        <TextBlock Text="API Key 仅保存在本机设置文件中，不会写入日志。"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="外观" Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                <Border Style="{StaticResource PanelCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="不透明度" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="保留一点桌面透感" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="128"
                                        Style="{StaticResource SettingsSlider}"
                                        Minimum="0.60"
                                        Maximum="1.00"
                                        SmallChange="0.05"
                                        LargeChange="0.10"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="不透明度"
                                        Value="{Binding Opacity, Mode=TwoWay}" />
                                <TextBlock Text="{Binding OpacityLabel}"
                                           Width="42"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Hairline}" Margin="0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="顶部距离" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="0 表示紧贴屏幕顶端，向右可留出间隙"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="128"
                                        Style="{StaticResource SettingsSlider}"
                                        Minimum="0"
                                        Maximum="40"
                                        SmallChange="1"
                                        LargeChange="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="顶部距离"
                                        Value="{Binding TopMargin, Mode=TwoWay}" />
                                <TextBlock Text="{Binding TopMarginLabel}"
                                           Width="48"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="2,14,2,0">
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="设置仅保存在本机 · 网页日历需联网"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource SettingsOverlayBrush}"
                BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="26,0">
                <TextBlock Text="更改会在保存后立即生效"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click" />
                    <Button Content="保存设置"
                            Style="{StaticResource AccentButton}"
                            IsDefault="True"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
