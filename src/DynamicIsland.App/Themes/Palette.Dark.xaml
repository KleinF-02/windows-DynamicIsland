    <SolidColorBrush x:Key="CalendarSourceBorderBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="CalendarTabBackgroundBrush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="CalendarTabBorderBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="CalendarCardBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="CalendarCardBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CalendarTimePillBackgroundBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="CalendarTimePillBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TodoCardBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="TodoCardBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TodoInputBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="TodoInputBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="CountdownSurfaceBrush" Color="#FF0B0E14" />
    <SolidColorBrush x:Key="CountdownBorderBrush" Color="#2E6FE7C8" />
    <SolidColorBrush x:Key="CountdownTrackBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SettingsOverlayBrush" Color="#66080A0F" />
    <SolidColorBrush x:Key="SettingsGlowBrush" Color="#176FE7C8" />
    <SolidColorBrush x:Key="NotificationOrbBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SettingsFieldBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="SettingsFieldBorderBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="PickerSurfaceBrush" Color="#FA0B0E14" />
    <SolidColorBrush x:Key="PickerBorderBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="PickerSearchBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="PickerSearchBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="PickerListBackgroundBrush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="PickerListBorderBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="PickerRowHoverBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="PickerRowSelectedBrush" Color="#1F6FE7C8" />
