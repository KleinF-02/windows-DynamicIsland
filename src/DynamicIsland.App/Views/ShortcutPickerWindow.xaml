<Window x:Class="DynamicIsland.App.Views.ShortcutPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加到常用软件"
        Width="560"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource PickerSurfaceBrush}"
            BorderBrush="{DynamicResource PickerBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="添加到常用软件" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="从开始菜单选择一个桌面应用"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="×"
                        Width="28"
                        Height="28"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource IconButton}"
                        Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource PickerSearchBackgroundBrush}"
                    BorderBrush="{DynamicResource PickerSearchBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,0"
                    Margin="0,18,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Height="30"
                             Style="{StaticResource SettingsTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="搜索开始菜单应用" />
                    <TextBlock Text="搜索应用…"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource PickerListBackgroundBrush}"
                    BorderBrush="{DynamicResource PickerListBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0">
                <Grid>
                    <ListBox x:Name="AppsList"
                             ItemsSource="{Binding FilteredApps}"
                             SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="AppsList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Row"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="8,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource PickerRowHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource PickerRowSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="8"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}"
                                               Width="26"
                                               Height="26"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}"
                                                   FontSize="8.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="开始菜单里没有找到可添加的快捷方式"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoMatches}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="{Binding HintText}"
                           FontSize="9.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource GhostButton}"
                            Height="30"
                            Padding="14,4"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="添加到格子"
                            Style="{StaticResource AccentButton}"
                            Height="30"
                            Padding="14,4"
                            IsDefault="True"
                            Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
